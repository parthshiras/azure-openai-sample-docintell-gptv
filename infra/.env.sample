# Sample Environment Configuration
# This file shows the structure of environment variables needed
# The actual values will be generated after running: ./deploy.sh dev

# Azure OpenAI Configuration
AZURE_OPENAI_API_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=<will-be-generated-after-deployment>
AZURE_OPENAI_ENDPOINT=<will-be-generated-after-deployment>
OPENAI_API_VERSION=2024-03-01-preview

# Azure Document Intelligence Configuration
DOC_INTEL_ENDPOINT=<will-be-generated-after-deployment>
DOC_INTEL_KEY=<will-be-generated-after-deployment>